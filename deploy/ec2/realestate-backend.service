[Unit]
Description=Real estate Spring Boot backend
Wants=network-online.target
After=network-online.target

[Service]
User=realestate
Group=realestate
WorkingDirectory=/opt/realestate-backend
EnvironmentFile=/etc/realestate-backend.env
ExecStart=/usr/bin/java -jar /opt/realestate-backend/application.jar
Restart=on-failure
RestartSec=10
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
